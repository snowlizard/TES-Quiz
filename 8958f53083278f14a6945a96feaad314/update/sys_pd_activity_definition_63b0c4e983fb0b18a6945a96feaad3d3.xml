        <category display_value="Interactive">708801831b0c1010affd0e55cc4bcb81</category>
        <description>&lt;p&gt;Displays a form for a given record. Users can update the record and manually mark the activity as complete or skipped.&lt;/p&gt;&#13;
&lt;p&gt;&lt;b&gt;Inputs:&lt;/b&gt;&lt;/p&gt;&#13;
&lt;ul&gt;&#13;
&lt;li&gt;&lt;b&gt;Table&lt;/b&gt; - Table for the user form&lt;/li&gt;&#13;
&lt;li&gt;&lt;b&gt;Record&lt;/b&gt; - Record displayed in the user form&lt;/li&gt;&#13;
&lt;li&gt;&lt;b&gt;Form View&lt;/b&gt; - UI view to use in the user form&lt;/li&gt;&#13;
&lt;li&gt;&lt;b&gt;Form Fields&lt;/b&gt; - Fields to display in the user form&lt;/li&gt;&#13;
&lt;li&gt;&lt;b&gt;Display Fields&lt;/b&gt; - Label and value fields to display above the user form.&lt;/li&gt;&#13;
&lt;li&gt;&lt;b&gt;Footer&lt;/b&gt; - Displayed below the form.&lt;/li&gt;&#13;
&lt;li&gt;&lt;b&gt;Show Attachments&lt;/b&gt; - When selected, includes attachments in the user form.&lt;/li&gt;&#13;
&lt;li&gt;&lt;b&gt;Show SLA&lt;/b&gt; - When selected, shows an SLA timer for the record.&lt;/li&gt;&#13;
&lt;li&gt;&lt;b&gt;Show Checklist&lt;/b&gt; - When selected, shows a checklist for the record.&lt;/li&gt;&#13;
&lt;li&gt;&lt;b&gt;Assignment Group&lt;/b&gt; - (Optional) Group required to complete, skip or restart the activity.&lt;/li&gt;&#13;
&lt;li&gt;&lt;b&gt;Assigned To&lt;/b&gt; - (Optional) User required to complete, skip or restart the activity.&lt;/li&gt;&#13;
&lt;/ul&gt;&#13;
&lt;p&gt;&lt;b&gt;Outputs:&lt;/b&gt;&lt;/p&gt;&#13;
&lt;ul&gt;&#13;
&lt;li&gt;&lt;b&gt;Table&lt;/b&gt; - Table for the user form&lt;/li&gt;&#13;
&lt;li&gt;&lt;b&gt;Record&lt;/b&gt; - Record updated in the user form&lt;/li&gt;&#13;
&lt;/ul&gt;</description>
        <enable_ai_agent>off</enable_ai_agent>
        <experience_display_preferences>associated_table=all;associated_record=all;experience_status_table=advanced;experience_status_record=advanced;tagline=all;icon=advanced;title=standard;description=standard;pending_title=advanced;pending_description=advanced;record_fields=all;footer=standard;form_view=all;form_fields=all;attachment_source=all;attachments_read_only=standard;show_sla=standard;show_checklist=standard;is_automated=advanced;</experience_display_preferences>
